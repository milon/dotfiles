#!/bin/zsh
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-commit: not inside a git work tree" >&2
    exit 1
}

export DOTFILES_ROOT="$repo_root"
source "$DOTFILES_ROOT/lib/ui.zsh"

typeset -i fail=0

print_section "Lint"
zsh "$DOTFILES_ROOT/tests/lint.zsh" || fail=1

print_section "Link sources"
source "$DOTFILES_ROOT/lib/root.zsh"
source "$DOTFILES_ROOT/lib/inventory.zsh"
dot_load_links
typeset -i missing=0
local key
for key in ${(ko)reply_links}; do
    if [[ ! -e "$DOT_CONFIG_DIR/$key" ]]; then
        print_error "links.toml: source missing -> config/$key"
        missing+=1
    fi
done
if (( missing == 0 )); then
    print_success "All ${#reply_links} symlink sources present"
else
    fail=1
fi

if (( fail )); then
    echo
    print_error "pre-commit failed — fix above, or: git commit --no-verify"
    exit 1
fi
exit 0
