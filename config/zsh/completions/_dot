#compdef dot

# Completions for bin/dot. Help commands come from lib/commands.zsh
# (DOT_CMDS_*), so Tab matches `dot help` and skips internal aliases
# like `check`. Shared options (-h, -y, …) come from DOT_SHARED_OPTS /
# DOT_CMD_SHARED via dot_cmd_option_lines — do not hardcode them here.

_dot() {
    local root=${DOTFILES_ROOT:-}
    if [[ -z $root ]]; then
        # this file: config/zsh/completions/_dot → repo root
        root=${${(%):-%x}:A:h:h:h:h}
    fi

    if [[ -f $root/lib/commands.zsh ]]; then
        source "$root/lib/commands.zsh"
    fi

    local -a cmds
    local category cmds_var name desc
    local -a cat_cmds
    cmds+=( 'help:Show help (list or per-command)' )
    for category in $DOT_CATEGORIES; do
        cmds_var="DOT_CMDS_${category}"
        cat_cmds=( ${(P)cmds_var} )
        for name in $cat_cmds; do
            desc=${DOT_CMD_DESC[$name]:-}
            cmds+=( "${name}:${desc}" )
        done
    done

    local curcontext="$curcontext" state line
    typeset -A opt_args

    local yes_desc=${${DOT_SHARED_OPTS[yes]#*$'\t'}:-Noninteractive / assume yes}
    local help_desc=${${DOT_SHARED_OPTS[help]#*$'\t'}:-Show help}

    _arguments -C \
        "(-y --yes)"{-y,--yes}"[${yes_desc}]" \
        "(-h --help)"{-h,--help}"[${help_desc}]" \
        '1:command:->command' \
        '*::arg:->args' && return 0

    case $state in
        command)
            _describe -t commands 'dot command' cmds
            ;;
        args)
            case $words[1] in
                help)
                    local -a help_cmds
                    for category in $DOT_CATEGORIES; do
                        cmds_var="DOT_CMDS_${category}"
                        cat_cmds=( ${(P)cmds_var} )
                        for name in $cat_cmds; do
                            desc=${DOT_CMD_DESC[$name]:-}
                            help_cmds+=( "${name}:${desc}" )
                        done
                    done
                    _describe -t commands 'command' help_cmds
                    ;;
                apply)
                    local -a modules
                    for category in $DOT_CATEGORIES; do
                        cmds_var="DOT_CMDS_${category}"
                        cat_cmds=( ${(P)cmds_var} )
                        for name in $cat_cmds; do
                            [[ $name == apply || $name == help ]] && continue
                            desc=${DOT_CMD_DESC[$name]:-}
                            modules+=( "${name}:${desc}" )
                        done
                    done
                    if [[ ${words[CURRENT]} == -* ]]; then
                        local -a apply_opts
                        local opt_line
                        for opt_line in ${(f)"$(dot_cmd_option_lines apply)"}; do
                            apply_opts+=( ${(f)"$(dot_opt_comp_spec "$opt_line")"} )
                        done
                        _arguments "${apply_opts[@]}"
                    else
                        _describe -t modules 'module' modules
                    fi
                    ;;
                *)
                    local cmd=$words[1]
                    # Aliases (e.g. check → doctor) resolve via module map for shared opts.
                    if [[ -z ${DOT_CMD_DESC[$cmd]:-} && -n ${DOT_CMD_MODULE[$cmd]:-} ]]; then
                        local spec=${DOT_CMD_MODULE[$cmd]}
                        local canon
                        for canon in ${(k)DOT_CMD_DESC}; do
                            if [[ ${DOT_CMD_MODULE[$canon]:-} == "$spec" ]]; then
                                cmd=$canon
                                break
                            fi
                        done
                    fi
                    local -a cmd_opts
                    local opt_line
                    for opt_line in ${(f)"$(dot_cmd_option_lines "$cmd")"}; do
                        cmd_opts+=( ${(f)"$(dot_opt_comp_spec "$opt_line")"} )
                    done
                    _arguments "${cmd_opts[@]}"
                    ;;
            esac
            ;;
    esac
}

_dot "$@"
