#compdef dot

# Completions for bin/dot. Help commands come from lib/commands.zsh
# (DOT_CMDS_*), so Tab matches `dot help` and skips internal aliases
# like `check`.

_dot() {
    local root=${DOTFILES_ROOT:-}
    if [[ -z $root ]]; then
        # this file: config/zsh/completions/_dot → repo root
        root=${${(%):-%x}:A:h:h:h:h}
    fi

    if [[ -f $root/lib/commands.zsh ]]; then
        source "$root/lib/commands.zsh"
    fi

    local -a cmds
    local category cmds_var name desc
    local -a cat_cmds
    cmds+=( 'help:Show this help message' )
    for category in $DOT_CATEGORIES; do
        cmds_var="DOT_CMDS_${category}"
        cat_cmds=( ${(P)cmds_var} )
        for name in $cat_cmds; do
            desc=${DOT_CMD_DESC[$name]:-}
            cmds+=( "${name}:${desc}" )
        done
    done

    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '(-y --yes)'{-y,--yes}'[Noninteractive / assume yes]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1:command:->command' \
        '*::arg:->args' && return 0

    case $state in
        command)
            _describe -t commands 'dot command' cmds
            ;;
        args)
            case $words[1] in
                apply)
                    # Public command names (same as help), minus meta apply/help.
                    local -a modules
                    for category in $DOT_CATEGORIES; do
                        cmds_var="DOT_CMDS_${category}"
                        cat_cmds=( ${(P)cmds_var} )
                        for name in $cat_cmds; do
                            [[ $name == apply || $name == help ]] && continue
                            desc=${DOT_CMD_DESC[$name]:-}
                            modules+=( "${name}:${desc}" )
                        done
                    done
                    _describe -t modules 'module' modules
                    ;;
                pull)
                    _arguments \
                        '(-u --update)'{-u,--update}'[Run composer update in PHP repos]'
                    ;;
            esac
            ;;
    esac
}

_dot "$@"
