#!/bin/zsh
set -euo pipefail

readonly BIN_NAME=$(basename "$0")

export DOTFILES_ROOT=${DOTFILES_ROOT:-$(cd "$(dirname "$(realpath "$0")")/.." && pwd)}
source "$DOTFILES_ROOT/lib/root.zsh"
source "$DOTFILES_ROOT/lib/ui.zsh"
source "$DOTFILES_ROOT/lib/commands.zsh"
source "$DOTFILES_ROOT/lib/help.zsh"

# Full install order for `dot apply` (no args)
typeset -a DOT_APPLY_ORDER=(
    precheck brew symlinks shell git mise php lerd mac hotkeys repos
)

# Display name: capitalize first letter (matches old bin/dotfiles)
dot_display_name() {
    local name=$1
    local first=${name[1]}
    local rest=${name[2,-1]}
    print -r -- "${(U)first}${rest}"
}

run_module() {
    local name=$1
    shift
    local action=${1:-apply}
    (( $# > 0 )) && shift

    local script="$DOT_MODULES_DIR/${name}.zsh"
    if [[ ! -f $script ]]; then
        print_error "Unknown module: $name"
        return 1
    fi

    local display
    display=$(dot_display_name "$name")
    # repos is the module behind both clone and pull
    [[ $name == repos && $action == apply ]] && display="Clone"
    [[ $name == repos && $action == pull ]] && display="Pull"

    print_section "$display"
    set +e
    zsh "$script" "$action" "$@"
    local ec=$?
    set -e
    if (( ec == 0 )); then
        echo
        print_success "${display} completed successfully"
        return 0
    fi
    echo
    print_error "${display} failed (exit code: ${ec})"
    return "$ec"
}

cmd_help() {
    ascii_art
    echo
    local -a yes_cmds
    yes_cmds=( ${(f)"$(dot_cmds_with_shared yes)"} )

    echo -e "${BOLD}${CYAN}${ARROW} Usage:${NC} ${YELLOW}${BIN_NAME} <command>${NC}"
    echo -e "         ${YELLOW}${BIN_NAME} help <command>${NC}  or  ${YELLOW}${BIN_NAME} <command> --help${NC}"
    if (( ${#yes_cmds} )); then
        echo -e "         ${YELLOW}${BIN_NAME} [--yes|-y] <command>${NC}  when the command prompts (${(j:, :)yes_cmds})"
    fi
    echo

    local category cmds_var color icon label cmd prefix desc
    local -a cmds cmd_list
    local -i i last

    for category in $DOT_CATEGORIES; do
        cmds_var="DOT_CMDS_${category}"
        cmds=( ${(P)cmds_var} )
        (( ${#cmds} )) || continue

        color=${DOT_CATEGORY_COLOR[$category]}
        icon=${DOT_CATEGORY_ICON[$category]}
        label=${DOT_CATEGORY_LABEL[$category]}
        print_tree_header "$color" "$icon" "$label"

        if [[ $category == core ]]; then
            cmd_list=( help $cmds )
        else
            cmd_list=( $cmds )
        fi

        last=${#cmd_list}
        for (( i = 1; i <= last; i++ )); do
            cmd=${cmd_list[i]}
            prefix="├"
            (( i == last )) && prefix="└"
            if [[ $cmd == help ]]; then
                desc="Show this help message"
            else
                desc=${DOT_CMD_DESC[$cmd]}
            fi
            print_tree_item "$color" "$prefix" "$cmd" "$desc"
        done
        echo
    done

    if dot_noninteractive; then
        print_info "Noninteractive mode on (--yes / DOT_NONINTERACTIVE=1)"
    fi
}

# Map a public command name (clone, hotkeys, …) or module filename for `dot apply`.
dot_resolve_apply_target() {
    local name=$1
    if [[ -n ${DOT_CMD_MODULE[$name]:-} ]]; then
        REPLY_MODULE=${${DOT_CMD_MODULE[$name]}%%:*}
        return 0
    fi
    if [[ -f ${DOT_MODULES_DIR}/${name}.zsh ]]; then
        REPLY_MODULE=$name
        return 0
    fi
    return 1
}

cmd_apply_all() {
    local -a mods=( "${DOT_APPLY_ORDER[@]}" )
    if ! dot_noninteractive; then
        mods+=( atuin )
    else
        print_warn "Skipping Atuin in noninteractive mode — run: dot atuin"
    fi
    mods+=( manual )
    local m
    for m in $mods; do
        run_module "$m" apply || return $?
    done
}

cmd_lint() {
    print_section "Lint"
    set +e
    zsh "$DOTFILES_ROOT/tests/lint.zsh"
    local ec=$?
    set -e
    if (( ec == 0 )); then
        echo
        print_success "Lint completed successfully"
        return 0
    fi
    echo
    print_error "Lint failed (exit code: ${ec})"
    return "$ec"
}

dispatch_command() {
    local command_name=$1
    shift

    # Symfony-style: dot <command> --help | -h
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        if [[ $command_name == help ]]; then
            cmd_help
        else
            dot_cmd_help "$command_name"
        fi
        return $?
    fi

    case "$command_name" in
        help)
            if (( $# == 0 )); then
                cmd_help
            else
                dot_cmd_help "$1"
            fi
            return $?
            ;;
        apply)
            if (( $# == 0 )); then
                cmd_apply_all
            else
                local m
                for m in "$@"; do
                    if [[ $m == pull ]]; then
                        print_error "pull is not an apply target — run: dot pull"
                        return 1
                    fi
                    if [[ $m == lint ]]; then
                        cmd_lint || return $?
                        continue
                    fi
                    if ! dot_resolve_apply_target "$m"; then
                        print_error "Unknown module or command: '${m}'"
                        return 1
                    fi
                    # `dot apply` always runs apply — never alternate actions (e.g. repos:pull)
                    run_module "$REPLY_MODULE" apply || return $?
                done
            fi
            return $?
            ;;
        check)
            # Alias for doctor (aggregated report)
            run_module doctor apply
            return $?
            ;;
        lint) cmd_lint; return $? ;;
    esac

    local spec=${DOT_CMD_MODULE[$command_name]:-}
    if [[ -z $spec ]]; then
        print_error "Unknown command: '${command_name}'"
        echo
        cmd_help
        return 1
    fi

    local module=${spec%%:*}
    local action=apply
    [[ $spec == *:* ]] && action=${spec#*:}
    run_module "$module" "$action" "$@"
}

main() {
    dot_consume_yes_args "$@"
    set -- "${REPLY[@]}"

    local command_name=${1:-}

    if [[ -z "$command_name" || "$command_name" == "-h" || "$command_name" == "--help" ]]; then
        cmd_help
        exit 0
    fi

    shift
    dispatch_command "$command_name" "$@"
}

main "$@"
