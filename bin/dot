#!/bin/zsh
set -euo pipefail

export DOTFILES_ROOT=${DOTFILES_ROOT:-$(cd "$(dirname "$(realpath "$0")")/.." && pwd)}
source "$DOTFILES_ROOT/lib/root.zsh"
source "$DOTFILES_ROOT/lib/ui.zsh"

# Module apply order for `dot apply` with no args
typeset -a DOT_APPLY_ORDER=(
    precheck brew link shell git mise php lerd mac wm repos
)

typeset -A DOT_MODULE_DESC=(
    [precheck]="Create local overrides; verify SSH / App Store"
    [brew]="Install Homebrew + Brewfile inventory"
    [link]="Symlink config/ onto ~ and ~/.config"
    [shell]="Sheldon lock / shell overrides"
    [git]="Git identity, include.path, hooks"
    [mise]="Install mise tools from config/mise"
    [php]="Host PHP / Composer globals"
    [lerd]="Lerd install + park ~/Code"
    [mac]="macOS defaults"
    [wm]="yabai + skhd (+ generated bin stub)"
    [repos]="Clone personal repos"
    [atuin]="Atuin Hub login/sync"
    [clean]="Clean brew/npm/composer/mise caches"
    [update]="Run topgrade"
    [manual]="Print remaining manual checklist"
)

run_module() {
    local name=$1
    shift
    local script="$DOT_MODULES_DIR/${name}.zsh"
    if [[ ! -f $script ]]; then
        print_error "Unknown module: $name"
        return 1
    fi
    print_section "${(C)name}"
    # Capture exit code before any other command — `if cmd` resets $? to 0.
    set +e
    zsh "$script" "$@"
    local ec=$?
    set -e
    if (( ec == 0 )); then
        echo
        print_success "${(C)name} completed successfully"
        return 0
    fi
    echo
    print_error "${(C)name} failed (exit code: ${ec})"
    return "$ec"
}

cmd_help() {
    ascii_art
    echo
    print_info "Usage: dot [--yes] <command> [args]"
    echo
    print_subsection "Commands"
    print_detail "apply [module...]   Idempotent setup (default: all core modules)"
    print_detail "check [module...]   Health check (default: all checkable modules)"
    print_detail "link                Alias for: apply link"
    print_detail "update              Run topgrade"
    print_detail "clone               Clone repos from inventory/repos.toml"
    print_detail "pull                Pull repos (+ optional --update for composer bumps)"
    print_detail "clean               Clean package manager caches"
    print_detail "manual              Remaining manual checklist"
    print_detail "atuin               Atuin Hub login/sync"
    print_detail "lint                Lint shell scripts"
    print_detail "help                This help"
    echo
    print_subsection "Modules"
    local m
    for m in ${(k)DOT_MODULE_DESC}; do
        printf "  %-10s %s\n" "$m" "$DOT_MODULE_DESC[$m]"
    done | sort
}

cmd_apply() {
    local -a mods
    if (( $# == 0 )); then
        mods=( "${DOT_APPLY_ORDER[@]}" )
        if ! dot_noninteractive; then
            mods+=( atuin )
        else
            print_warn "Skipping Atuin in noninteractive mode — run: dot atuin"
        fi
        mods+=( manual )
    else
        mods=( "$@" )
    fi
    local m
    for m in $mods; do
        run_module "$m" apply || return $?
    done
}

cmd_check() {
    local -a mods
    if (( $# == 0 )); then
        mods=( brew link shell git mise php lerd mac wm repos )
    else
        mods=( "$@" )
    fi
    typeset -i fail=0
    local m
    for m in $mods; do
        run_module "$m" check || fail=1
    done
    (( fail == 0 ))
}

main() {
    dot_consume_yes_args "$@"
    set -- "${REPLY[@]}"

    local cmd=${1:-help}
    (( $# > 0 )) && shift

    case "$cmd" in
        help|-h|--help) cmd_help ;;
        apply)          cmd_apply "$@" ;;
        check)          cmd_check "$@" ;;
        link)           run_module link apply ;;
        update)         run_module update apply ;;
        clone)          run_module repos apply ;;
        pull)           run_module repos pull "$@" ;;
        clean)          run_module clean apply ;;
        manual)         run_module manual apply ;;
        atuin)          run_module atuin apply ;;
        lint)           zsh "$DOTFILES_ROOT/tests/lint.zsh" ;;
        precheck|brew|shell|git|mise|php|lerd|mac|wm|repos)
            run_module "$cmd" apply "$@"
            ;;
        *)
            print_error "Unknown command: $cmd"
            echo
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
