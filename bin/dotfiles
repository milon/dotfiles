#!/bin/zsh

# Constants
readonly BIN_NAME=$(basename "$0")

# Load config
export bin_dir=$(dirname "$(realpath "$0")")
export dotfiles_dir=$(dirname "$bin_dir")
export support_dir="$dotfiles_dir/support"

# Load functions (includes color constants, output helpers, run_step)
source "$support_dir/functions.sh"

# Shared command registry (COMMAND_SCRIPTS + help metadata)
source "$support_dir/commands.sh"

# Print usage (sourced; avoids run_step so we do not show "Running Help" / success footer)
run_help() {
    source "$support_dir/help.sh"
}

# Main command dispatcher
main() {
    # Global flags before the subcommand: dotfiles --yes doctor
    dotfiles_consume_yes_args "$@"
    set -- "${REPLY[@]}"

    local command_name=$1

    if [[ -z "$command_name" || "$command_name" == "-h" || "$command_name" == "--help" ]]; then
        run_help
        exit 0
    fi

    case "$command_name" in
        help)
            run_help
            ;;
        *)
            if [[ -n "${COMMAND_SCRIPTS[$command_name]}" ]]; then
                local script="${COMMAND_SCRIPTS[$command_name]}"
                # Capitalize first letter for display using zsh parameter expansion
                local first_char="${command_name[1]}"
                local rest="${command_name[2,-1]}"
                local display_name="${(U)first_char}${rest}"
                shift
                run_step "$display_name" "$script" "$@"
            else
                print_error "Unknown command: '${command_name}'"
                echo
                run_help
                exit 1
            fi
            ;;
    esac
}

main "$@"
