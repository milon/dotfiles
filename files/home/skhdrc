# Modifiers (built into skhd — no Karabiner remap required):
#   rcmd  = right Command
#   hyper = cmd + alt + ctrl + shift
# Reload this file: hyper - r  (skhd also auto-reloads on save)

# App launcher — open by bundle ID so renames don't break bindings
rcmd - g : open -b "com.google.Chrome"            # Google Chrome
rcmd - t : open -b "com.mitchellh.ghostty"        # Ghostty
rcmd - c : open -b "com.microsoft.VSCode"         # Visual Studio Code
rcmd - m : open -b "com.apple.MobileSMS"          # Messages
rcmd - w : open -b "net.whatsapp.WhatsApp"        # WhatsApp
rcmd - s : open -b "com.tinyspeck.slackmacgap"    # Slack
rcmd - a : open -b "com.openai.codex"             # ChatGPT (current OpenAI desktop ID)
rcmd - l : open -b "com.linear"                   # Linear
rcmd - p : open -b "com.jetbrains.PhpStorm"       # PhpStorm
rcmd - n : open -b "notion.id"                    # Notion
rcmd - z : open -b "com.tinyapp.TablePlus"        # TablePlus
rcmd - f : open -b "com.apple.finder"             # Finder

# Window sizing (yabai) — grid is rows:cols:start_x:start_y:width:height
hyper - f : yabai -m window --grid 1:1:0:0:1:1     # Full screen (fills the display)
hyper - w : yabai -m window --grid 10:10:2:2:6:6   # Reasonable size (~60%, centered)
hyper - m : yabai -m window --grid 20:20:1:1:18:18 # Almost maximize (~90%, centered)

# Window cycle (yabai-cycle-grid) — repeated presses cycle sizes anchored to the arrow:
#   left/right : 1/2 -> 2/3 -> 1/3 -> 1/2 ...    (smart size detection)
#   up         : full -> centered 2/3 -> centered 1/2 -> ...
cmd + alt + shift - left   : yabai-cycle-grid left
cmd + alt + shift - right  : yabai-cycle-grid right
cmd + alt + shift - up     : yabai-cycle-grid center

# Window focus: jump to the nearest visible window in the given direction.
# Custom script (instead of `yabai -m window --focus DIR`) because the latter
# only works with managed windows, and we run with `layout float`.
cmd + ctrl + shift - left   : yabai-focus-direction west
cmd + ctrl + shift - right  : yabai-focus-direction east
cmd + ctrl + shift - up     : yabai-focus-direction north
cmd + ctrl + shift - down   : yabai-focus-direction south

# Move the focused window to the display in the given direction, and move
# focus along with it (see bin/yabai-move-display).
hyper - left  : yabai-move-display west
hyper - right : yabai-move-display east
hyper - up    : yabai-move-display north
hyper - down  : yabai-move-display south

# Display focus (jumps to the display in the given direction)
ctrl + shift - left  : yabai -m display --focus west
ctrl + shift - right : yabai -m display --focus east
ctrl + shift - up    : yabai -m display --focus north
ctrl + shift - down  : yabai -m display --focus south
