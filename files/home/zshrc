# Homebrew first so `sheldon` (and other brew tools) are on PATH.
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Repo root — this file is $DOTFILES_DIR/files/home/zshrc (symlinked to ~/.zshrc).
export DOTFILES_DIR="${DOTFILES_DIR:-${${(%):-%N}:A:h:h:h}}"

# Plugins + shell env: ~/.config/sheldon/plugins.toml
eval "$(sheldon source)"

# Per-machine overrides (untracked) — must stay last.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
